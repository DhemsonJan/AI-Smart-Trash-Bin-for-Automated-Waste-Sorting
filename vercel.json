{
  "builds": [
    { "src": "BinbotDashboard/**/*.php", "use": "vercel-php@0.9.0" },
    { "src": "BinbotAdmin/**/*.php", "use": "vercel-php@0.9.0" },
    { "src": "BinbotDashboard/**/*.{css,js,jpg,png,gif,ico,svg,txt,md}", "use": "@vercel/static" },
    { "src": "BinbotAdmin/**/*.{css,js,jpg,png,gif,ico,svg,txt,md}", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/BinbotDashboard/Binbot.php", "status": 307 }
  ]
}
